{
  "expo": {
    "name": "TrueShuffle",
    "slug": "trueshuffle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trueshuffle.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.trueshuffle.app"
    },
    "web": {
      "favicon": "./assets/favicon.ico"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#121212",
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (expo-background-task) creates its Room database by reflection; R8 must keep the constructors.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.** { *; }"
          }
        }
      ]
    ],
    "scheme": "trueshuffle",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "65e0ee3f-0e22-4a72-b6b2-b79e47b28e78"
      }
    }
  }
}
